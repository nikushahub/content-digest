      ],
      "parameters": {
        "jsCode": "const d = $input.first().json.output ?? {};\nconst src = $('Check Content').first().json;\nconst tags = (d.tags ?? []).map(t => String(t).toLowerCase().replace(/^#/, '').trim()).filter(Boolean);\n\nreturn [{ json: {\n  id: $execution.id,\n  status: 'ok',\n  type: 'text',\n  url: src.sourceUrl,\n  data: {\n    title: d.title || src.title || '',\n    summary: d.summary ?? '',\n    keyTakeaways: d.keyTakeaways ?? [],\n    tags,\n    category: d.category ?? 'Other',\n    language: d.language || src.language || '',\n    source: { platform: src.platform, method: src.method, truncated: src.truncated ?? false },\n    wordCount: src.wordCount,\n  },\n} }];"
      }
