    {
      "id": "n-parse-supadata",
      "name": "Parse Supadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        144
      ],
      "parameters": {
        "jsCode": "// Handles both the first transcript call and each job-status poll.\nconst MAX_POLLS = 24; // ~2 minutes at 5s per poll\nconst ctx = $('Classify URL').first().json;\nconst res = $input.first().json;\nconst base = { sourceUrl: ctx.sourceUrl, platform: ctx.platform, method: 'transcript', title: '', pending: false };\nconst fail = (httpStatus, message) => [{ json: { ...base, ok: false, httpStatus, message } }];\n\nif (res.error && res.statusCode === undefined) {\n  return fail(502, 'Could not reach the transcript service. Please try again.');\n}\n\nconst status = res.statusCode ?? 0;\nconst body = res.body && typeof res.body === 'object' ? res.body : {};\n\n// Async job started (long videos) or still running\nlet jobId = body.jobId;\nif (!jobId && ['queued', 'active'].includes(body.status)) {\n  try { jobId = $('Wait 5s').itemMatching(0).json.jobId; } catch (e) { jobId = undefined; }\n}\nif (jobId && (status === 202 || ['queued', 'active'].includes(body.status) || !body.status)) {\n  if ($runIndex >= MAX_POLLS) return fail(504, 'Transcription is taking too long. Try a shorter video.');\n  return [{ json: { ...base, pending: true, jobId } }];\n}\n\nif (body.status === 'failed') {\n  return fail(422, body.error?.message || body.error || 'The transcript job failed for this video.');\n}\n\nif (status === 200 && body.content) {\n  const text = Array.isArray(body.content) ? body.content.map(c => c.text).join(' ') : String(body.content);\n  return [{ json: { ...base, ok: true, text, language: body.lang || '' } }];\n}\n\nif (status === 206) return fail(422, 'No transcript is available for this video.');\nif (status === 401 || status === 403) return fail(502, 'The transcript service rejected our API key. Check the Supadata credential in n8n.');\nif (status === 429) return fail(429, 'Transcript service rate limit reached. Please wait a moment and try again.');\nif (status === 404) return fail(404, 'That video could not be found. It may be private or deleted.');\nreturn fail(502, body.message || body.error || `Transcript service error (HTTP ${status}).`);"
      }
    },
