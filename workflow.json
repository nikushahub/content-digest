      "name": "Prepare History Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2540,
        300
      ],
      "parameters": {
        "jsCode": "// Runs after the webhook has already responded, for both success and error paths.\nconst j = $input.first().json;\nconst requestId = String($execution.id);\n\nif (j.status === 'ok') {\n  const d = j.data;\n  return [{ json: {\n    requestId,\n    status: 'ok',\n    url: j.url,\n    platform: d.source.platform,\n    method: d.source.method,\n    title: d.title,\n    category: d.category,\n    tags: d.tags.join(', '),\n    summary: d.summary,\n    keyTakeaways: JSON.stringify(d.keyTakeaways),\n    language: d.language,\n    wordCount: d.wordCount,\n    httpStatus: 200,\n    errorMessage: '',\n  } }];\n}\n\nconst body = $('Webhook').first().json.body ?? {};\nconst rawError = j.message || (typeof j.error === 'string' ? j.error : j.error?.message) || 'Unknown error';\nreturn [{ json: {\n  requestId,\n  status: 'error',\n  url: String(j.sourceUrl ?? body.url ?? '').slice(0, 2000),\n  platform: j.platform ?? '',\n  method: j.method ?? '',\n  title: j.title ?? '',\n  category: '',\n  tags: '',\n  summary: '',\n  keyTakeaways: '[]',\n  language: '',\n  wordCount: j.wordCount ?? 0,\n  httpStatus: j.httpStatus ?? 500,\n  errorMessage: String(rawError).slice(0, 1000),\n} }];"
      }
    },
