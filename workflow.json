    {
      "id": "n-parse-article",
      "name": "Parse Article",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        512
      ],
      "parameters": {
        "jsCode": "const ctx = $('Classify URL').first().json;\nconst res = $input.first().json;\nconst base = { sourceUrl: ctx.sourceUrl, platform: ctx.platform, method: 'article', title: '', pending: false };\nconst fail = (httpStatus, message) => [{ json: { ...base, ok: false, httpStatus, message } }];\n\nif (res.error && res.statusCode === undefined) return fail(502, 'Could not reach the page reader. Please try again.');\n\nconst status = res.statusCode ?? 0;\nconst body = res.body;\nif (status === 429) return fail(429, 'The page reader is rate limited. Please wait a moment and try again.');\nif (status < 200 || status >= 300) return fail(422, `Couldn't read that page (HTTP ${status}). It may block automated readers or require a login.`);\n\nconst data = body && typeof body === 'object' ? (body.data ?? body) : { content: String(body ?? '') };\nreturn [{ json: { ...base, ok: true, title: data.title || '', text: data.content || '' } }];"
      }
    },
    {
      "id": "n-check",
      "name": "Check Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        320
      ],
      "parameters": {
        "jsCode": "// Shared by every branch: reject empty extractions, trim very long text for the LLM.\nconst MAX_CHARS = 120000;\nconst MIN_CHARS = 80;\nconst item = $input.first().json;\nif (item.ok === false) return [{ json: item }];\n\nconst text = String(item.text ?? '').replace(/[ \\t]+\\n/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\nif (text.length < MIN_CHARS) {\n  return [{ json: { ...item, ok: false, httpStatus: 422, message: \"We couldn't find enough text at that link to summarize. It may be private, paywalled, or have no speech.\" } }];\n}\n\nconst wordCount = text.split(/\\s+/).filter(Boolean).length;\nreturn [{ json: { ...item, ok: true, text: text.slice(0, MAX_CHARS), truncated: text.length > MAX_CHARS, wordCount } }];"
      }
    },
