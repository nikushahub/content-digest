      "id": "n-classify",
      "name": "Classify URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ],
      "parameters": {
        "jsCode": "// Validate the submitted URL and decide which extraction branch handles it.\n// (The Code-node sandbox has no global URL class, so parse with a regex.)\nconst body = $input.first().json.body ?? {};\nconst raw = typeof body.url === 'string' ? body.url.trim() : '';\n\nconst m = raw.match(/^https?:\\/\\/([^\\/?#\\s]+)([^?#\\s]*)\\S*$/i);\nconst host = m ? m[1].split('@').pop().split(':')[0].toLowerCase().replace(/^(www|m|mobile)\\./, '') : '';\nif (!m || !/^[a-z0-9-]+(\\.[a-z0-9-]+)+$/.test(host)) {\n  return [{ json: { route: 'invalid', httpStatus: 400, message: 'Please provide a valid http(s) URL in the \"url\" field.' } }];\n}\nconst path = m[2] || '/';\nconst is = (...domains) => domains.some(d => host === d || host.endsWith('.' + d));\n\nlet platform = 'article';\nif (is('youtube.com', 'youtu.be', 'youtube-nocookie.com')) platform = 'youtube';\nelse if (is('instagram.com')) platform = 'instagram';\nelse if (is('facebook.com', 'fb.watch', 'fb.com')) platform = 'facebook';\nelse if (is('tiktok.com')) platform = 'tiktok';\nelse if (is('x.com', 'twitter.com')) platform = 'x';\nelse if (/\\.(mp3|m4a|wav|ogg|oga|flac|aac|opus|mp4|webm)$/i.test(path)) platform = 'media';\n\nconst route = platform === 'article' ? 'article' : platform === 'media' ? 'media' : 'video';\nreturn [{ json: { route, platform, sourceUrl: raw } }];"
      }
    },
