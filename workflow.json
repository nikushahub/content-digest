    {
      "id": "n-parse-gemini",
      "name": "Parse Transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        320
      ],
      "parameters": {
        "jsCode": "const ctx = $('Classify URL').first().json;\nconst j = $input.first().json;\nconst base = { sourceUrl: ctx.sourceUrl, platform: ctx.platform, method: 'transcript', title: '', pending: false };\n\nif (j.error) {\n  return [{ json: { ...base, ok: false, httpStatus: 502, message: 'Could not transcribe that audio file. Make sure the link is a public, direct audio/video file.' } }];\n}\n\nconst parts = j.content?.parts ?? j.candidates?.[0]?.content?.parts ?? [];\nconst text = typeof j.text === 'string' ? j.text : parts.map(p => p.text ?? '').join('\\n');\nreturn [{ json: { ...base, ok: true, text } }];"
      }
    },
