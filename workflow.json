    {
      "id": "n-summarize",
      "name": "Summarize",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "position": [
        1824,
        224
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Source type: {{ $json.platform }} ({{ $json.method }})\nURL: {{ $json.sourceUrl }}\nOriginal title: {{ $json.title || 'unknown' }}\n\n<content>\n{{ $json.text }}\n</content>",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert editor who writes digests of articles and video transcripts.\n\nRules:\n- Use only information present in the content. Do not invent facts, numbers, names, or quotes.\n- Write title, summary, and keyTakeaways in the same language as the content.\n- title: concise and informative (keep the original title if it is good).\n- summary: 2-4 short paragraphs of plain text separated by blank lines.\n- keyTakeaways: 3-7 specific, standalone points.\n- tags: 3-8 short lowercase topic tags in English, without '#'.\n- category: exactly one of Technology, Business, Science, Health, Politics, Education, Entertainment, Lifestyle, Sports, Other.\n- language: ISO 639-1 code of the content.\n\nTranscripts may lack punctuation or contain speech-recognition errors; infer the intended meaning sensibly."
            }
          ]
        },
        "batching": {},
        "needsFallback": true
      }
