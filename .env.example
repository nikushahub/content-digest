# Production webhook URL of the n8n "Content Digest" workflow (server-side only, never exposed to the browser).
# Locally: http://localhost:5678/webhook/content-digest. On Vercel: the public tunnel or n8n Cloud URL.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/content-digest

# Shared secret sent as the X-Digest-Secret header; must match the Webhook node's Header Auth credential in n8n.
N8N_WEBHOOK_SECRET=
